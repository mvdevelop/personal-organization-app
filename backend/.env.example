# ─────────────────────────────────────────────────────────────
# OrgApp Backend — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# MongoDB (Atlas ou local)
# Generate a secure connection string at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/personal-org?retryWrites=true&w=majority

# JWT — MUST be at least 32 characters
# Generate with: openssl rand -base64 48
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CSRF — Separate secret for CSRF token signing (recommended)
# Generate with: openssl rand -base64 32
CSRF_SECRET=your-csrf-secret-change-in-production

# Server
PORT=3001
NODE_ENV=development

# CORS (frontend URL — comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# OpenRouter (opcional — para assistente IA)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini
