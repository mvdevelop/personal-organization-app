@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthProvider
@inject UserPreferencesService Prefs
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_theme" IsDarkMode="Prefs.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="sa-shell @(Prefs.IsDarkMode ? "is-dark" : "is-light")">

    @if (_mobileOpen)
    {
        <div class="sa-scrim" @onclick="CloseMobileNav"></div>
    }

    <aside class="sa-sidebar @(Prefs.SidebarCollapsed ? "is-collapsed" : "") @(_mobileOpen ? "is-mobile-open" : "")"
           aria-label="Navegação principal">
        <div class="sa-sidebar-inner">
            <a class="sa-brand" href="/" aria-label="Smart Agenda — início">
                <span class="sa-logo" aria-hidden="true">
                    <svg viewBox="0 0 32 32" role="presentation" focusable="false">
                        <rect x="7" y="7" width="18" height="18" rx="5" transform="rotate(45 16 16)" fill="url(#saLogoGradient)" />
                        <circle cx="16" cy="16" r="4.2" fill="#111318" fill-opacity="0.55" />
                        <defs>
                            <linearGradient id="saLogoGradient" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#9293FF" />
                                <stop offset="1" stop-color="#7778F6" />
                            </linearGradient>
                        </defs>
                    </svg>
                </span>
                <span class="sa-brand-text">
                    <span class="sa-brand-name">Smart Agenda</span>
                    <span class="sa-brand-tag">YOUR DAY, IN SYNC</span>
                </span>
            </a>

            <div class="sa-profile" title="@_email">
                <span class="sa-avatar" aria-hidden="true">@_initial</span>
                <span class="sa-profile-text">
                    <span class="sa-profile-name">@_userName</span>
                    <span class="sa-profile-mail">@_email</span>
                </span>
            </div>

            <nav class="sa-nav" aria-label="Seções">
                @foreach (var item in NavItems)
                {
                    <a class="mud-nav-link @(IsActive(item.Href) ? "active" : "")"
                       href="@item.Href"
                       title="@item.Label"
                       aria-current="@(IsActive(item.Href) ? "page" : null)"
                       @onclick="CloseMobileNav">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                        <span class="mud-nav-link-text">@item.Label</span>
                    </a>
                }
            </nav>

            <div class="sa-sidebar-foot">
                <div class="sa-promo">
                    <span class="sa-promo-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" /></span>
                    <span class="sa-promo-title">Um novo nível de foco</span>
                    <span class="sa-promo-text">Desbloqueie todo o potencial da sua rotina com o Smart Plus.</span>
                    <button class="sa-promo-btn" type="button" @onclick="HandlePlans">Conhecer planos</button>
                </div>

                <button class="sa-collapse" type="button"
                        @onclick="HandleToggleSidebar"
                        aria-label="@(Prefs.SidebarCollapsed ? "Expandir menu lateral" : "Recolher menu lateral")">
                    <MudIcon Icon="@(Prefs.SidebarCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)" Size="Size.Small" />
                    <span class="sa-collapse-label">Recolher menu</span>
                </button>
            </div>
        </div>
    </aside>

    <div class="sa-main">
        <header class="sa-topbar">
            <button class="sa-icon-btn sa-menu-btn" type="button" @onclick="OpenMobileNav" aria-label="Abrir menu">
                <MudIcon Icon="@Icons.Material.Filled.Menu" />
            </button>

            <div class="sa-crumbs">
                <span>Workspace</span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                <strong>@GetPageTitle()</strong>
            </div>

            <div class="sa-topbar-spacer"></div>

            <button class="sa-icon-btn" type="button" @onclick="OpenSearch" aria-label="Pesquisar (Ctrl + K)" title="Pesquisar">
                <MudIcon Icon="@Icons.Material.Filled.Search" />
            </button>

            <button class="sa-icon-btn" type="button" @onclick="ShowNotifications" aria-label="Notificações" title="Notificações">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" />
                <span class="sa-notif-dot" aria-hidden="true"></span>
            </button>

            <button class="sa-icon-btn" type="button" @onclick="HandleToggleTheme"
                    aria-label="@(Prefs.IsDarkMode ? "Ativar tema claro" : "Ativar tema escuro")"
                    title="@(Prefs.IsDarkMode ? "Tema claro" : "Tema escuro")">
                <MudIcon Icon="@(Prefs.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" />
            </button>

            <span class="sa-plan">Plano gratuito</span>

            <button class="sa-user" type="button" @onclick="ShowAccount" aria-label="Conta de @_userName">
                <span class="sa-avatar" aria-hidden="true">@_initial</span>
                <span class="sa-user-name">@_userName</span>
            </button>
        </header>

        <main class="sa-page">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _mobileOpen;
    private string _userName = "Usuário";
    private string _email = "";
    private string _initial = "U";
    private string _currentPath = "";

    private readonly MudTheme _theme = Theme.ScheduleTheme.Create();

    private record NavItem(string Label, string Href, string Icon);

    private static readonly NavItem[] NavItems =
    {
        new("Dashboard", "/", Icons.Material.Outlined.SpaceDashboard),
        new("Tarefas", "/tasks", Icons.Material.Outlined.Checklist),
        new("Notas", "/notes", Icons.Material.Outlined.StickyNote2),
        new("Hábitos", "/habits", Icons.Material.Outlined.Loop),
        new("Metas", "/goals", Icons.Material.Outlined.Flag),
        new("Estudos", "/studies", Icons.Material.Outlined.MenuBook),
        new("Assistente IA", "/ai", Icons.Material.Outlined.AutoAwesome),
    };

    protected override void OnInitialized()
    {
        Prefs.OnChange += OnPreferencesChanged;
        Navigation.LocationChanged += OnLocationChanged;

        var user = AuthProvider.GetCurrentUser();
        _userName = string.IsNullOrWhiteSpace(user?.Name) ? "Usuário" : user!.Name;
        _email = user?.Email ?? "";
        _initial = string.IsNullOrWhiteSpace(_userName) ? "U" : _userName[..1].ToUpperInvariant();
        _currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
    }

    private void OnPreferencesChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = Navigation.ToBaseRelativePath(e.Location);
        _mobileOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string href)
    {
        if (href == "/")
            return string.IsNullOrEmpty(_currentPath) || _currentPath == "/";

        return _currentPath.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }

    private void OpenMobileNav() => _mobileOpen = true;

    private void CloseMobileNav() => _mobileOpen = false;

    private async Task HandleToggleSidebar()
    {
        if (_mobileOpen)
        {
            _mobileOpen = false;
            return;
        }

        await Prefs.ToggleSidebarAsync();
    }

    private Task HandleToggleTheme() => Prefs.ToggleThemeAsync();

    private Task HandlePlans()
    {
        Snackbar.Add("O plano Smart Plus chega em breve. Continue organizando no plano gratuito.", Severity.Info);
        return Task.CompletedTask;
    }

    private Task ShowNotifications()
    {
        Snackbar.Add("Nenhuma notificação nova por enquanto.", Severity.Normal);
        return Task.CompletedTask;
    }

    private Task ShowAccount()
    {
        Snackbar.Add($"{_userName} · @_email · Plano gratuito", Severity.Normal);
        return Task.CompletedTask;
    }

    private Task OpenSearch()
    {
        Navigation.NavigateTo("/search");
        return Task.CompletedTask;
    }

    private async Task HandleLogout()
    {
        await AuthProvider.SignOut();
        Navigation.NavigateTo("/sign-in", forceLoad: true);
    }

    private string GetPageTitle()
    {
        var uri = _currentPath.TrimStart('/');
        return uri switch
        {
            "" or "/" => "Dashboard",
            "tasks" => "Tarefas",
            "notes" => "Notas",
            "habits" => "Hábitos",
            "goals" => "Metas",
            "studies" => "Estudos",
            "ai" => "Assistente IA",
            "search" => "Pesquisa",
            _ => "Smart Agenda"
        };
    }

    public void Dispose()
    {
        Prefs.OnChange -= OnPreferencesChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
