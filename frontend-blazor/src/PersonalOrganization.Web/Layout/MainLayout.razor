@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthProvider
@inject UserPreferencesService Prefs

<MudThemeProvider Theme="_theme" IsDarkMode="Prefs.IsDarkMode" />
<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Class="app-drawer">
        <MudDrawerHeader Class="app-brand pa-5">
            <div class="brand-mark">S</div>
            <div>
                <MudText Typo="Typo.h6" Class="brand-name">Schedule</MudText>
                <MudText Typo="Typo.caption" Class="brand-subtitle">seu espaço, no seu ritmo</MudText>
            </div>
        </MudDrawerHeader>

        <MudNavMenu Class="px-3 app-nav-menu">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Dashboard</MudNavLink>
            <MudNavLink Href="/tasks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ListAlt">Tarefas</MudNavLink>
            <MudNavLink Href="/notes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NoteAlt">Notas</MudNavLink>
            <MudNavLink Href="/habits" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.TipsAndUpdates">Hábitos</MudNavLink>
            <MudNavLink Href="/goals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Star">Metas</MudNavLink>
            <MudNavLink Href="/studies" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">Estudos</MudNavLink>
            <MudNavLink Href="/ai" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SmartToy">Assistente IA</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="d-flex flex-column" Style="min-height: 100vh;">
        <MudAppBar Elevation="0" Class="px-4 app-bar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="@ToggleDrawer" Class="mr-2" Title="Alternar navegação" />
            <div class="app-bar-context flex-grow-1">
                <MudText Typo="Typo.caption" Class="app-bar-label">Schedule</MudText>
                <MudText Typo="Typo.subtitle1" Class="app-bar-title">@GetPageTitle()</MudText>
            </div>
            <MudIconButton Icon="@(Prefs.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           OnClick="@HandleToggleDarkMode"
                           Title="Alternar tema" />
            <MudChip Size="Size.Small" Class="ml-2 mr-2 user-chip" T="string">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                @_userName
            </MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" OnClick="@HandleLogout" Title="Sair" Color="Color.Default" />
        </MudAppBar>

        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-4 main-content">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string _userName = "";

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#65558f",
            Secondary = "#b65f85",
            Info = "#5b6c9c",
            Success = "#3a7a6b",
            Warning = "#b0781f",
            Error = "#b8433f",
            Surface = "#fffdfa",
            Background = "#f7f5f2",
            AppbarBackground = "#fffdfa",
            DrawerBackground = "#fffdfa",
            Divider = "#e8e3dc",
            TextPrimary = "#29253d",
            TextSecondary = "#79758b",
            ActionDefault = "#79758b",
            ActionDisabled = "#c3bdc9",
            Dark = "#29253d",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#c3b3e8",
            Secondary = "#e8a3bd",
            Info = "#a9b8e2",
            Success = "#8fc9b7",
            Warning = "#e0ba7a",
            Error = "#e79a95",
            Surface = "#1f1c2b",
            Background = "#141220",
            AppbarBackground = "#1a1727",
            DrawerBackground = "#1a1727",
            Divider = "#332e43",
            TextPrimary = "#f1eef7",
            TextSecondary = "#a9a3bb",
            ActionDefault = "#a9a3bb",
            ActionDisabled = "#4a4459",
            Dark = "#141220",
        },
        Typography = new Typography()
        {
            Default = new Default()
            {
                FontFamily = new[] { "Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif" },
                FontSize = "0.875rem",
                FontWeight = 400,
                LineHeight = 1.5,
                LetterSpacing = "normal",
            },
        },
    };

    protected override void OnInitialized()
    {
        Prefs.OnChange += OnPreferencesChanged;
        var user = AuthProvider.GetCurrentUser();
        _userName = user?.Name ?? "Usuário";
    }

    private void OnPreferencesChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task HandleToggleDarkMode()
    {
        await Prefs.ToggleThemeAsync();
    }

    private async Task HandleLogout()
    {
        await AuthProvider.SignOut();
        Navigation.NavigateTo("/sign-in", forceLoad: true);
    }

    private string GetPageTitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri);
        return uri switch
        {
            "" or "/" => "Dashboard",
            "tasks" => "Tarefas",
            "notes" => "Notas",
            "habits" => "Hábitos",
            "goals" => "Metas",
            "studies" => "Estudos",
            "ai" => "Assistente IA",
            _ => "Schedule"
        };
    }

    public void Dispose()
    {
        Prefs.OnChange -= OnPreferencesChanged;
    }
}
