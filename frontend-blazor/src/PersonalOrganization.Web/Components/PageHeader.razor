@using Microsoft.AspNetCore.Components

<header class="page-header">
    <div>
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <MudText Typo="Typo.overline" Class="eyebrow">@Eyebrow</MudText>
        }
        <MudText Typo="Typo.h4" Class="page-header-title">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</header>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Eyebrow { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
}
