{
  "name": "Smart Agenda",
  "short_name": "Smart Agenda",
  "description": "Sua agenda inteligente para tarefas, hábitos, metas, estudos e notas com IA",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "orientation": "any",
  "scope": "/",
  "lang": "pt-BR",
  "categories": ["productivity", "education", "lifestyle"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/",
      "description": "Painel principal"
    },
    {
      "name": "Tarefas",
      "short_name": "Tarefas",
      "url": "/tasks",
      "description": "Gerenciar tarefas"
    },
    {
      "name": "Hábitos",
      "short_name": "Hábitos",
      "url": "/habits",
      "description": "Check-in de hábitos"
    },
    {
      "name": "Assistente IA",
      "short_name": "IA",
      "url": "/ai",
      "description": "Chat com assistente inteligente"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+task",
      "url": "/tasks?create=true&text=%s"
    }
  ]
